{
  "name": "SVG to PNG Converter",
  "version": "1.1.6",
  "slug": "svg-to-png",
  "description": "Convert Material Design Icons SVG to PNG for Home Assistant notifications",
  "url": "https://github.com/Netesfiu/hass-addons/tree/master/svg-to-png",
  "init": false,
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
